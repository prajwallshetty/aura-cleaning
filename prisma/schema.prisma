// Aura Laundry ERP — database schema
// Architecture: Order → Garment → Processing → Location → Delivery → Payment

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  OWNER
  BRANCH_MANAGER
  COUNTER_STAFF
  WASHING_STAFF
  IRONING_STAFF
  QC_STAFF
  PACKING_STAFF
  DRIVER
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum BranchType {
  HEAD_OFFICE
  BRANCH
  CENTRAL_PROCESSING_UNIT
}

enum OrderType {
  WALK_IN
  PICKUP
  DELIVERY
}

enum OrderPriority {
  NORMAL
  EXPRESS
  URGENT
}

enum OrderStatus {
  RECEIVED
  SORTING
  WASHING
  DRYING
  IRONING
  QUALITY_CHECK
  PACKING
  READY
  OUT_FOR_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  REFUNDED
  ON_HOLD
}

enum GarmentStatus {
  RECEIVED
  SORTING
  SORTED
  WASHING
  WASHED
  DRYING
  DRIED
  IRONING
  IRONED
  QC_PENDING
  QC_PASSED
  QC_FAILED
  REWASH
  REWORK
  PACKING
  PACKED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  LOST
  DAMAGED
  RETURNED
}

enum ProcessingStage {
  RECEIVING
  SORTING
  WASHING
  DRYING
  IRONING
  QUALITY_CHECK
  PACKING
  DISPATCH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
  REWASH
  REWORK
  SKIPPED
}

enum PricingMode {
  PER_PIECE
  PER_KG
  FLAT
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  ONLINE
  BANK_TRANSFER
  CREDIT
  OTHER
}

enum PaymentProvider {
  MANUAL
  RAZORPAY
  UPI_INTENT
  CARD_TERMINAL
}

enum PaymentState {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  CANCELLED
}

enum InvoiceType {
  ORDER
  B2B_MONTHLY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

enum PickupStatus {
  REQUESTED
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  PICKED_UP
  RECEIVED_AT_LAUNDRY
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DRIVER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum InventoryCategory {
  DETERGENT
  BLEACH
  FABRIC_SOFTENER
  STAIN_REMOVER
  CHEMICAL
  PACKAGING
  HANGER
  COVER
  TAG
  LABEL
  OTHER
}

enum InventoryTxnType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  CONSUMPTION
  RETURN
  WASTAGE
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum PurchaseInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum B2BAccountType {
  HOTEL
  HOSPITAL
  HOSTEL
  RESTAURANT
  SALON
  GYM
  CORPORATE
  OTHER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum BillingCycle {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum ScheduleType {
  PICKUP
  DELIVERY
}

enum ComplaintType {
  DAMAGED_GARMENT
  LOST_GARMENT
  MISSING_GARMENT
  COLOR_FADING
  STAIN_NOT_REMOVED
  WRONG_GARMENT
  WRONG_QUANTITY
  LATE_DELIVERY
  OTHER
}

enum ComplaintStatus {
  OPEN
  UNDER_INVESTIGATION
  AWAITING_CUSTOMER
  RESOLVED
  REJECTED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintResolution {
  REFUND
  REWASH
  REWORK
  COMPENSATION
  REPLACEMENT
  APOLOGY
  NO_ACTION
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationEvent {
  ORDER_RECEIVED
  PROCESSING_STARTED
  ORDER_READY
  OUT_FOR_DELIVERY
  DELIVERED
  PAYMENT_RECEIVED
  PAYMENT_REMINDER
  ORDER_DELAYED
  PICKUP_SCHEDULED
  COMPLAINT_REGISTERED
  COMPLAINT_RESOLVED
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  WEEKLY_OFF
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
  MATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  MAINTENANCE
  TRANSPORT
  CONSUMABLES
  MARKETING
  MISCELLANEOUS
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ============================================================================
// ORGANISATION, IDENTITY & ACCESS CONTROL
// ============================================================================

model Branch {
  id       String     @id @default(cuid())
  code     String     @unique
  name     String
  type     BranchType @default(BRANCH)
  parentId String?
  parent   Branch?    @relation("BranchHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Branch[]   @relation("BranchHierarchy")

  addressLine String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  gstNumber   String?

  openingTime String?
  closingTime String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  orders                Order[]
  garments              Garment[]
  racks                 Rack[]
  processingTasks       ProcessingTask[]
  processingBatches     ProcessingBatch[]
  invoices              Invoice[]
  payments              Payment[]
  pickups               Pickup[]
  deliveries            Delivery[]
  inventoryStocks       InventoryStock[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  purchaseReturns       PurchaseReturn[]
  complaints            Complaint[]
  expenses              Expense[]
  b2bAccounts           B2BAccount[]
  attendances           Attendance[]
  shifts                Shift[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  garmentHistory        GarmentStatusHistory[]
  locationHistory       GarmentLocationHistory[]
  customers             Customer[]
  scanEvents            ScanEvent[]

  @@index([parentId])
  @@index([isActive])
  @@map("branches")
}

model User {
  id           String     @id @default(cuid())
  employeeCode String?    @unique
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  role         UserRole   @default(COUNTER_STAFF)
  status       UserStatus @default(ACTIVE)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)

  image              String?
  emailVerified      DateTime?
  lastLoginAt        DateTime?
  mustChangePassword Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  permissions  UserPermission[]
  staffProfile StaffProfile?
  driver       Driver?

  createdOrders        Order[]                  @relation("OrderCreatedBy")
  garmentScans         Garment[]                @relation("GarmentLastScannedBy")
  garmentHistory       GarmentStatusHistory[]
  locationHistory      GarmentLocationHistory[]
  assignedTasks        ProcessingTask[]         @relation("TaskAssignee")
  taskHistory          ProcessingHistory[]
  batches              ProcessingBatch[]        @relation("BatchOperator")
  paymentsReceived     Payment[]                @relation("PaymentReceivedBy")
  refundsProcessed     Refund[]                 @relation("RefundProcessedBy")
  inventoryTxns        InventoryTransaction[]
  purchaseOrdersMade   PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  goodsReceived        GoodsReceipt[]           @relation("GoodsReceivedBy")
  supplierPayments     SupplierPayment[]        @relation("SupplierPaymentBy")
  complaintsAssigned   Complaint[]              @relation("ComplaintAssignee")
  complaintsCreated    Complaint[]              @relation("ComplaintCreatedBy")
  complaintsResolved   Complaint[]              @relation("ComplaintResolvedBy")
  complaintAttachments ComplaintAttachment[]
  garmentPhotos        GarmentPhoto[]
  attendances          Attendance[]
  leaves               Leave[]                  @relation("LeaveUser")
  leavesApproved       Leave[]                  @relation("LeaveApprover")
  expensesCreated      Expense[]                @relation("ExpenseCreatedBy")
  expensesApproved     Expense[]                @relation("ExpenseApprovedBy")
  auditLogs            AuditLog[]
  invoicesIssued       Invoice[]                @relation("InvoiceIssuedBy")
  customersCreated     Customer[]               @relation("CustomerCreatedBy")
  scanEvents           ScanEvent[]              @relation("ScanEventScannedBy")

  @@index([branchId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Sequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("sequences")
}

model Setting {
  key       String   @id
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================================================
// STAFF
// ============================================================================

model StaffProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       String?
  designation      String?
  dateOfJoining    DateTime?
  monthlySalary    Decimal?  @db.Decimal(12, 2)
  emergencyContact String?
  addressLine      String?
  idProofType      String?
  idProofNumber    String?
  shiftId          String?
  shift            Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shiftId])
  @@map("staff_profiles")
}

model Shift {
  id        String   @id @default(cuid())
  name      String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffProfiles StaffProfile[]
  attendances   Attendance[]

  @@index([branchId])
  @@map("shifts")
}

model Attendance {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String?
  branch   Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  date     DateTime         @db.Date
  status   AttendanceStatus @default(PRESENT)
  checkIn  DateTime?
  checkOut DateTime?
  shiftId  String?
  shift    Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([branchId, date])
  @@map("attendances")
}

model Leave {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  type         LeaveType   @default(CASUAL)
  fromDate     DateTime    @db.Date
  toDate       DateTime    @db.Date
  reason       String?
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedBy   User?       @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("leaves")
}

model Driver {
  id            String  @id @default(cuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String?
  vehicleNumber String?
  vehicleType   String?
  isAvailable   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickups    Pickup[]
  deliveries Delivery[]

  @@map("drivers")
}

// ============================================================================
// CATALOGUE — SERVICES & GARMENT TYPES
// ============================================================================

model Service {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String
  description     String?
  pricingMode     PricingMode       @default(PER_PIECE)
  basePrice       Decimal           @db.Decimal(12, 2)
  turnaroundHours Int               @default(48)
  stages          ProcessingStage[]
  isActive        Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates      ServiceRate[]
  orderItems OrderItem[]
  garments   Garment[]
  rateCards  B2BRateCard[]

  @@index([isActive])
  @@map("services")
}

model GarmentType {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  category        String   @default("GENERAL")
  defaultWeightKg Decimal? @db.Decimal(8, 3)
  icon            String?
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rates      ServiceRate[]
  orderItems OrderItem[]
  garments   Garment[]
  rateCards  B2BRateCard[]

  @@index([isActive])
  @@map("garment_types")
}

model ServiceRate {
  id            String      @id @default(cuid())
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  garmentTypeId String
  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Cascade)
  price         Decimal     @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, garmentTypeId])
  @@index([serviceId])
  @@map("service_rates")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type          OrderType     @default(WALK_IN)
  priority      OrderPriority @default(NORMAL)
  status        OrderStatus   @default(RECEIVED)
  paymentStatus PaymentStatus @default(UNPAID)

  // Customer details are captured on the order itself (billing / pickup / delivery).
  customerName  String
  customerPhone String
  customerEmail String?
  addressLine   String?
  city          String?
  pincode       String?
  landmark      String?

  // The order keeps its own copy of the details above so an invoice never
  // changes when a customer record is later edited; the link is for history.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  b2bAccountId String?
  b2bAccount   B2BAccount? @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)

  placedAt           DateTime  @default(now())
  expectedDeliveryAt DateTime
  readyAt            DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal @default(0) @db.Decimal(12, 2)
  discountReason    String?
  taxableAmount     Decimal @default(0) @db.Decimal(12, 2)
  gstRate           Decimal @default(18) @db.Decimal(5, 2)
  gstAmount         Decimal @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal @default(0) @db.Decimal(12, 2)
  refundedAmount    Decimal @default(0) @db.Decimal(12, 2)

  totalPieces   Int     @default(0)
  totalWeightKg Decimal @default(0) @db.Decimal(10, 3)

  specialInstructions String?
  stainNotes          String?
  damageNotes         String?

  rackSlotId String?
  rackSlot   RackSlot? @relation(fields: [rackSlotId], references: [id], onDelete: SetNull)

  tagPrintCount    Int       @default(0)
  tagLastPrintedAt DateTime?

  createdById String?
  createdBy   User?   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  garments      Garment[]
  statusHistory OrderStatusHistory[]
  invoices      Invoice[]
  payments      Payment[]
  refunds       Refund[]
  pickups       Pickup[]
  deliveries    Delivery[]
  complaints    Complaint[]
  notifications Notification[]
  invoiceLines  InvoiceLine[]
  scanEvents    ScanEvent[]

  @@index([branchId, status])
  @@index([customerPhone])
  @@index([customerId])
  @@index([placedAt])
  @@index([expectedDeliveryAt])
  @@index([paymentStatus])
  @@index([b2bAccountId])
  @@index([rackSlotId])
  @@map("orders")
}

model OrderItem {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  garmentTypeId String
  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Restrict)

  quantity    Int         @default(1)
  weightKg    Decimal     @default(0) @db.Decimal(10, 3)
  pricingMode PricingMode @default(PER_PIECE)
  unitPrice   Decimal     @db.Decimal(12, 2)
  lineTotal   Decimal     @db.Decimal(12, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garments Garment[]

  @@index([orderId])
  @@index([serviceId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  userId     String?
  userName   String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ============================================================================
// GARMENTS — the operational heart of the system
// ============================================================================

model Garment {
  id           String @id @default(cuid())
  garmentCode  String @unique
  qrPayload    String @unique
  barcodeValue String @unique

  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String?
  orderItem     OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  garmentTypeId String
  garmentType   GarmentType @relation(fields: [garmentTypeId], references: [id], onDelete: Restrict)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  status       GarmentStatus   @default(RECEIVED)
  currentStage ProcessingStage @default(RECEIVING)

  color       String?
  brand       String?
  size        String?
  fabric      String?
  stainNotes  String?
  damageNotes String?
  rewashCount Int     @default(0)
  reworkCount Int     @default(0)

  rackSlotId String?
  rackSlot   RackSlot? @relation(fields: [rackSlotId], references: [id], onDelete: SetNull)

  lastScannedAt   DateTime?
  lastScannedById String?
  lastScannedBy   User?     @relation("GarmentLastScannedBy", fields: [lastScannedById], references: [id], onDelete: SetNull)

  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory   GarmentStatusHistory[]
  locationHistory GarmentLocationHistory[]
  tasks           ProcessingTask[]
  photos          GarmentPhoto[]
  complaints      Complaint[]

  @@index([orderId])
  @@index([branchId, status])
  @@index([currentStage])
  @@index([rackSlotId])
  @@index([garmentTypeId])
  @@map("garments")
}

/// Immutable ledger — rows are only ever inserted, never updated or deleted.
model GarmentStatusHistory {
  id         String          @id @default(cuid())
  garmentId  String
  garment    Garment         @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  fromStatus GarmentStatus?
  toStatus   GarmentStatus
  stage      ProcessingStage
  branchId   String?
  branch     Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  note       String?
  scannedVia String?
  createdAt  DateTime        @default(now())

  @@index([garmentId, createdAt])
  @@index([createdAt])
  @@map("garment_status_history")
}

model GarmentPhoto {
  id           String   @id @default(cuid())
  garmentId    String
  garment      Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  url          String
  storageKey   String
  mimeType     String?
  sizeBytes    Int?
  kind         String   @default("INTAKE")
  caption      String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([garmentId])
  @@map("garment_photos")
}

// ============================================================================
// PROCESSING
// ============================================================================

model ProcessingBatch {
  id          String          @id @default(cuid())
  batchCode   String          @unique
  stage       ProcessingStage
  branchId    String
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status      TaskStatus      @default(PENDING)
  operatorId  String?
  operator    User?           @relation("BatchOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks ProcessingTask[]

  @@index([branchId, stage, status])
  @@map("processing_batches")
}

model ProcessingTask {
  id        String          @id @default(cuid())
  garmentId String
  garment   Garment         @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  stage     ProcessingStage
  status    TaskStatus      @default(PENDING)
  branchId  String
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  batchId String?
  batch   ProcessingBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  sequence        Int       @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  durationSeconds Int?
  failureReason   String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history ProcessingHistory[]

  @@unique([garmentId, stage])
  @@index([branchId, stage, status])
  @@index([assignedToId])
  @@index([batchId])
  @@map("processing_tasks")
}

model ProcessingHistory {
  id         String         @id @default(cuid())
  taskId     String
  task       ProcessingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus TaskStatus?
  toStatus   TaskStatus
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  note       String?
  createdAt  DateTime       @default(now())

  @@index([taskId, createdAt])
  @@map("processing_history")
}

// ============================================================================
// RACK & LOCATION
// ============================================================================

model Rack {
  id          String  @id @default(cuid())
  branchId    String
  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots RackSlot[]

  @@unique([branchId, code])
  @@index([branchId])
  @@map("racks")
}

model RackSlot {
  id       String  @id @default(cuid())
  rackId   String
  rack     Rack    @relation(fields: [rackId], references: [id], onDelete: Cascade)
  code     String
  label    String?
  capacity Int     @default(20)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  garments    Garment[]
  orders      Order[]
  historyFrom GarmentLocationHistory[] @relation("LocationFromSlot")
  historyTo   GarmentLocationHistory[] @relation("LocationToSlot")

  @@unique([rackId, code])
  @@index([rackId])
  @@map("rack_slots")
}

/// Immutable ledger of where a garment has physically been.
model GarmentLocationHistory {
  id         String    @id @default(cuid())
  garmentId  String
  garment    Garment   @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  fromSlotId String?
  fromSlot   RackSlot? @relation("LocationFromSlot", fields: [fromSlotId], references: [id], onDelete: SetNull)
  toSlotId   String?
  toSlot     RackSlot? @relation("LocationToSlot", fields: [toSlotId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([garmentId, createdAt])
  @@map("garment_location_history")
}

// ============================================================================
// BILLING & PAYMENTS
// ============================================================================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  type          InvoiceType   @default(ORDER)
  status        InvoiceStatus @default(ISSUED)
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // The order keeps its own copy of the details above so an invoice never
  // changes when a customer record is later edited; the link is for history.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  b2bAccountId String?
  b2bAccount   B2BAccount? @relation(fields: [b2bAccountId], references: [id], onDelete: SetNull)
  periodStart  DateTime?
  periodEnd    DateTime?

  billToName    String
  billToPhone   String?
  billToEmail   String?
  billToAddress String?
  billToGstin   String?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal @default(0) @db.Decimal(12, 2)
  gstRate        Decimal @default(18) @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(12, 2)
  igstAmount     Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal @default(0) @db.Decimal(12, 2)
  amountDue      Decimal @default(0) @db.Decimal(12, 2)

  issuedAt DateTime  @default(now())
  dueAt    DateTime?
  notes    String?

  issuedById String?
  issuedBy   User?   @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]
  refunds  Refund[]

  @@index([branchId, issuedAt])
  @@index([orderId])
  @@index([b2bAccountId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id            String   @id @default(cuid())
  paymentNumber String   @unique
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  amount   Decimal         @db.Decimal(12, 2)
  method   PaymentMethod   @default(CASH)
  provider PaymentProvider @default(MANUAL)
  state    PaymentState    @default(CAPTURED)

  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  reference         String?
  isAdvance         Boolean @default(false)
  notes             String?

  paidAt       DateTime @default(now())
  receivedById String?
  receivedBy   User?    @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]

  @@index([branchId, paidAt])
  @@index([orderId])
  @@index([invoiceId])
  @@index([providerPaymentId])
  @@map("payments")
}

model Refund {
  id           String   @id @default(cuid())
  refundNumber String   @unique
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentId    String?
  payment      Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(CASH)
  status        RefundStatus  @default(REQUESTED)
  reason        String
  notes         String?
  processedById String?
  processedBy   User?         @relation("RefundProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ============================================================================
// PICKUP & DELIVERY
// ============================================================================

model Pickup {
  id           String       @id @default(cuid())
  pickupNumber String       @unique
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status       PickupStatus @default(REQUESTED)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  scheduledAt DateTime
  assignedAt  DateTime?
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  receivedAt  DateTime?

  contactName   String
  contactPhone  String
  addressLine   String
  landmark      String?
  failureReason String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([driverId, scheduledAt])
  @@index([orderId])
  @@map("pickups")
}

model Delivery {
  id             String         @id @default(cuid())
  deliveryNumber String         @unique
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status         DeliveryStatus @default(PENDING)

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  scheduledAt    DateTime
  assignedAt     DateTime?
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  rescheduledFor DateTime?

  contactName  String
  contactPhone String
  addressLine  String
  landmark     String?

  amountToCollect  Decimal        @default(0) @db.Decimal(12, 2)
  amountCollected  Decimal        @default(0) @db.Decimal(12, 2)
  collectionMethod PaymentMethod?

  isPartial      Boolean @default(false)
  garmentCount   Int     @default(0)
  attemptCount   Int     @default(0)
  failureReason  String?
  receivedByName String?
  proofPhotoUrl  String?
  signatureUrl   String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
  @@index([driverId, scheduledAt])
  @@index([orderId])
  @@map("deliveries")
}

// ============================================================================
// INVENTORY
// ============================================================================

model InventoryItem {
  id            String            @id @default(cuid())
  sku           String            @unique
  name          String
  category      InventoryCategory @default(OTHER)
  unit          String            @default("pcs")
  description   String?
  minStockLevel Decimal           @default(0) @db.Decimal(12, 3)
  costPrice     Decimal           @default(0) @db.Decimal(12, 2)
  isActive      Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks       InventoryStock[]
  transactions InventoryTransaction[]
  poItems      PurchaseOrderItem[]
  grnItems     GoodsReceiptItem[]
  returnItems  PurchaseReturnItem[]

  @@index([category])
  @@index([isActive])
  @@map("inventory_items")
}

model InventoryStock {
  id       String        @id @default(cuid())
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity Decimal       @default(0) @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, branchId])
  @@index([branchId])
  @@map("inventory_stocks")
}

model InventoryTransaction {
  id           String           @id @default(cuid())
  itemId       String
  item         InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type         InventoryTxnType
  quantity     Decimal          @db.Decimal(12, 3)
  balanceAfter Decimal          @default(0) @db.Decimal(12, 3)
  unitCost     Decimal?         @db.Decimal(12, 2)

  counterpartBranchId String?
  reference           String?
  notes               String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([branchId, createdAt])
  @@index([type])
  @@map("inventory_transactions")
}

// ============================================================================
// PURCHASES & SUPPLIERS
// ============================================================================

model Supplier {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  addressLine   String?
  gstNumber     String?
  paymentTerms  String?
  creditDays    Int     @default(0)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  payments         SupplierPayment[]
  returns          PurchaseReturn[]

  @@index([isActive])
  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  poNumber   String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branchId   String
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  status     PurchaseOrderStatus @default(DRAFT)

  orderDate    DateTime  @default(now())
  expectedDate DateTime?

  subtotal  Decimal @default(0) @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)
  notes     String?

  createdById String?
  createdBy   User?   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    PurchaseOrderItem[]
  receipts GoodsReceipt[]
  invoices PurchaseInvoice[]
  returns  PurchaseReturn[]

  @@index([supplierId])
  @@index([branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  poId             String
  po               PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity         Decimal       @db.Decimal(12, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 3)
  unitPrice        Decimal       @db.Decimal(12, 2)
  taxRate          Decimal       @default(0) @db.Decimal(5, 2)
  lineTotal        Decimal       @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id           String        @id @default(cuid())
  grnNumber    String        @unique
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  receivedAt   DateTime      @default(now())
  receivedById String?
  receivedBy   User?         @relation("GoodsReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  notes        String?

  createdAt DateTime @default(now())

  items GoodsReceiptItem[]

  @@index([poId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id        String        @id @default(cuid())
  grnId     String
  grn       GoodsReceipt  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Decimal       @db.Decimal(12, 3)
  unitPrice Decimal       @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([grnId])
  @@map("goods_receipt_items")
}

model PurchaseInvoice {
  id            String                @id @default(cuid())
  invoiceNumber String
  supplierId    String
  supplier      Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  poId          String?
  po            PurchaseOrder?        @relation(fields: [poId], references: [id], onDelete: SetNull)
  status        PurchaseInvoiceStatus @default(UNPAID)

  invoiceDate DateTime  @default(now())
  dueDate     DateTime?
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments SupplierPayment[]

  @@unique([supplierId, invoiceNumber])
  @@index([status])
  @@map("purchase_invoices")
}

model SupplierPayment {
  id            String           @id @default(cuid())
  paymentNumber String           @unique
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceId     String?
  invoice       PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Decimal          @db.Decimal(12, 2)
  method        PaymentMethod    @default(BANK_TRANSFER)
  reference     String?
  notes         String?
  paidAt        DateTime         @default(now())
  paidById      String?
  paidBy        User?            @relation("SupplierPaymentBy", fields: [paidById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_payments")
}

model PurchaseReturn {
  id           String         @id @default(cuid())
  returnNumber String         @unique
  supplierId   String
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  poId         String?
  po           PurchaseOrder? @relation(fields: [poId], references: [id], onDelete: SetNull)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reason       String
  total        Decimal        @default(0) @db.Decimal(12, 2)
  returnedAt   DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PurchaseReturnItem[]

  @@index([supplierId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id        String         @id @default(cuid())
  returnId  String
  return    PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Decimal        @db.Decimal(12, 3)
  unitPrice Decimal        @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([returnId])
  @@map("purchase_return_items")
}

// ============================================================================
// B2B / CORPORATE
// ============================================================================

model B2BAccount {
  id                 String         @id @default(cuid())
  code               String         @unique
  businessName       String
  type               B2BAccountType @default(CORPORATE)
  contactPerson      String?
  phone              String
  email              String?
  billingAddress     String?
  gstNumber          String?
  creditLimit        Decimal        @default(0) @db.Decimal(12, 2)
  creditDays         Int            @default(30)
  paymentTerms       String?
  outstandingBalance Decimal        @default(0) @db.Decimal(12, 2)
  isActive           Boolean        @default(true)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts  B2BContract[]
  schedules  B2BSchedule[]
  statements B2BStatement[]
  orders     Order[]
  invoices   Invoice[]

  @@index([type])
  @@index([isActive])
  @@map("b2b_accounts")
}

model B2BContract {
  id                  String         @id @default(cuid())
  contractNumber      String         @unique
  accountId           String
  account             B2BAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  status              ContractStatus @default(ACTIVE)
  billingCycle        BillingCycle   @default(MONTHLY)
  startDate           DateTime
  endDate             DateTime?
  minimumMonthlyValue Decimal        @default(0) @db.Decimal(12, 2)
  terms               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rateCards B2BRateCard[]

  @@index([accountId, status])
  @@map("b2b_contracts")
}

model B2BRateCard {
  id            String       @id @default(cuid())
  contractId    String
  contract      B2BContract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  garmentTypeId String?
  garmentType   GarmentType? @relation(fields: [garmentTypeId], references: [id], onDelete: SetNull)
  pricingMode   PricingMode  @default(PER_PIECE)
  rate          Decimal      @db.Decimal(12, 2)
  effectiveFrom DateTime     @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, serviceId, garmentTypeId])
  @@index([contractId])
  @@map("b2b_rate_cards")
}

model B2BSchedule {
  id        String       @id @default(cuid())
  accountId String
  account   B2BAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      ScheduleType
  dayOfWeek Int
  timeSlot  String
  isActive  Boolean      @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@map("b2b_schedules")
}

model B2BStatement {
  id              String        @id @default(cuid())
  statementNumber String        @unique
  accountId       String
  account         B2BAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  orderCount      Int           @default(0)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount       Decimal       @default(0) @db.Decimal(12, 2)
  status          InvoiceStatus @default(ISSUED)
  generatedAt     DateTime      @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, periodStart, periodEnd])
  @@index([accountId])
  @@map("b2b_statements")
}

// ============================================================================
// COMPLAINTS & DAMAGE
// ============================================================================

model Complaint {
  id              String            @id @default(cuid())
  complaintNumber String            @unique
  type            ComplaintType
  status          ComplaintStatus   @default(OPEN)
  priority        ComplaintPriority @default(MEDIUM)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  garmentId String?
  garment   Garment? @relation(fields: [garmentId], references: [id], onDelete: SetNull)

  raisedByName  String
  raisedByPhone String?
  description   String

  assignedToId String?
  assignedTo   User?   @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  investigationNotes String?
  resolution         ComplaintResolution?
  resolutionNotes    String?
  compensationAmount Decimal?             @db.Decimal(12, 2)
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         User?                @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ComplaintCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments ComplaintAttachment[]

  @@index([branchId, status])
  @@index([orderId])
  @@index([garmentId])
  @@index([createdAt])
  @@map("complaints")
}

model ComplaintAttachment {
  id           String    @id @default(cuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  url          String
  storageKey   String
  mimeType     String?
  sizeBytes    Int?
  caption      String?
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([complaintId])
  @@map("complaint_attachments")
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model NotificationTemplate {
  id       String              @id @default(cuid())
  code     String              @unique
  name     String
  channel  NotificationChannel
  event    NotificationEvent
  subject  String?
  body     String
  language String              @default("en")
  isActive Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([event, channel])
  @@map("notification_templates")
}

model Notification {
  id      String              @id @default(cuid())
  event   NotificationEvent
  channel NotificationChannel
  status  NotificationStatus  @default(PENDING)

  templateId String?
  template   NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  recipientName  String?
  recipientPhone String?
  recipientEmail String?
  subject        String?
  body           String
  payload        Json?

  providerMessageId String?
  errorMessage      String?
  retryCount        Int       @default(0)
  sentAt            DateTime?
  deliveredAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs NotificationLog[]

  @@index([status])
  @@index([orderId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationLog {
  id             String             @id @default(cuid())
  notificationId String
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         NotificationStatus
  detail         String?
  createdAt      DateTime           @default(now())

  @@index([notificationId, createdAt])
  @@map("notification_logs")
}

// ============================================================================
// EXPENSES
// ============================================================================

model Expense {
  id            String          @id @default(cuid())
  expenseNumber String          @unique
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category      ExpenseCategory @default(MISCELLANEOUS)
  status        ExpenseStatus   @default(PENDING)
  amount        Decimal         @db.Decimal(12, 2)
  description   String
  paidTo        String?
  paymentMethod PaymentMethod   @default(CASH)
  reference     String?
  attachmentUrl String?
  expenseDate   DateTime        @default(now())

  createdById  String?
  createdBy    User?     @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById String?
  approvedBy   User?     @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, expenseDate])
  @@index([category])
  @@map("expenses")
}

/// Counter-facing customer record. Orders keep their own copy of the contact
/// details so historical invoices never change; this row is the searchable
/// directory and the place lifetime figures are rolled up.
model Customer {
  id       String @id @default(cuid())
  code     String @unique
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  name  String
  phone String
  email String?

  addressLine String?
  city        String?
  pincode     String?
  landmark    String?

  notes    String?
  isActive Boolean @default(true)

  // Rolled up from orders and payments whenever either changes.
  orderCount        Int       @default(0)
  totalSpent        Decimal   @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal   @default(0) @db.Decimal(14, 2)
  lastOrderAt       DateTime?

  createdById String?
  createdBy   User?   @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  invoices Invoice[]

  @@unique([branchId, phone])
  @@index([branchId, name])
  @@index([phone])
  @@map("customers")
}

/// Append-only log of every tag scan, so the counter can see what was scanned,
/// by whom, and what happened next.
model ScanEvent {
  id       String @id @default(cuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  rawCode     String
  resolvedAs  ScanTargetKind @default(UNKNOWN)
  orderId     String?
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  garmentCode String?

  succeeded Boolean    @default(true)
  message   String?
  action    String?
  source    ScanSource @default(KEYBOARD)

  scannedById String?
  scannedBy   User?   @relation("ScanEventScannedBy", fields: [scannedById], references: [id], onDelete: SetNull)

  scannedAt DateTime @default(now())

  @@index([branchId, scannedAt])
  @@index([orderId])
  @@map("scan_events")
}

enum ScanTargetKind {
  ORDER
  GARMENT
  SLOT
  UNKNOWN
}

enum ScanSource {
  KEYBOARD
  CAMERA
  HARDWARE
}
